<?xml version="1.0" encoding="utf-8"?>
<ExtensionInfo
    id="shimano-ep8"
    displayName="@string/extension_name"
    icon="@mipmap/ic_launcher"
    scansDevices="true">

    <DataType
        typeId="ep8-mode"
        displayName="EP8 Modus"
        description="Unterstützungsstufe (OFF, ECO, TRAIL, BOOST, WALK)"
        graphical="true" />

    <DataType
        typeId="ep8-range"
        displayName="EP8 Reichweite"
        description="Restreichweite im aktiven Modus in km"
        graphical="false" />

    <DataType
        typeId="ep8-battery"
        displayName="EP8 Akku"
        description="Akkuladestand in Prozent (Numerisch)"
        graphical="false" />

    <DataType
        typeId="ep8-battery-bar"
        displayName="EP8 Akku Balken"
        description="Akkuladestand als Balken (Visuell)"
        graphical="true" />

    <DataType
        typeId="ep8-power"
        displayName="EP8 Leistung"
        description="Fahrer-Trittleistung in Watt"
        graphical="false" />

    <DataType
        typeId="ep8-cadence"
        displayName="EP8 Kadenz"
        description="Trittfrequenz in RPM"
        graphical="false" />

    <DataType
        typeId="ep8-speed"
        displayName="EP8 Tempo"
        description="E-Bike Geschwindigkeit in km/h"
        graphical="false" />

    <DataType
        typeId="ep8-trip"
        displayName="EP8 Trip-km"
        description="Tagesstrecke in km"
        graphical="false" />

    <DataType
        typeId="ep8-odometer"
        displayName="EP8 Gesamt-km"
        description="Gesamtlaufleistung (Odometer)"
        graphical="false" />

</ExtensionInfo>
