<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="6dp"
    android:paddingTop="0dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <!-- Grüner Balken (> 50 %) -->
    <ProgressBar
        android:id="@+id/kteps_bar_green"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_gravity="center_vertical"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="#40888888"
        android:progressTint="#4CAF50"
        android:scaleY="5.0"
        android:visibility="visible" />

    <!-- Gelber Balken (21 % bis 50 %) -->
    <ProgressBar
        android:id="@+id/kteps_bar_yellow"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_gravity="center_vertical"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="#40888888"
        android:progressTint="#FDD835"
        android:scaleY="5.0"
        android:visibility="gone" />

    <!-- Roter Balken (<= 20 %) -->
    <ProgressBar
        android:id="@+id/kteps_bar_red"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_gravity="center_vertical"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="#40888888"
        android:progressTint="#F44336"
        android:scaleY="5.0"
        android:visibility="gone" />

    <!-- Dunkles Prozent-Badge unten links (nur bei voller Kachelbreite sichtbar) -->
    <TextView
        android:id="@+id/kteps_battery_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="4dp"
        android:background="#CC1A1A1A"
        android:includeFontPadding="false"
        android:paddingStart="5dp"
        android:paddingTop="1dp"
        android:paddingEnd="5dp"
        android:paddingBottom="1dp"
        android:text="-- %"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>
